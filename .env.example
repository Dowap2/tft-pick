# Google AdSense (없으면 사이드바에 점선 자리만 표시)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_LEFT=1234567890
NEXT_PUBLIC_ADSENSE_SLOT_RIGHT=0987654321

# 로컬 개발: next dev(3000) 와 wrangler dev(8787) 를 따로 띄우고 API 는 8787 로
NEXT_PUBLIC_API_BASE=http://localhost:8787

# Supabase (공개 가능 — anon 키는 RLS로 보호)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 비밀 — 절대 NEXT_PUBLIC_ 붙이지 말 것, 커밋 금지
SUPABASE_SERVICE_ROLE_KEY=        # 수집기/시드 스크립트가 raw.* 에 쓸 때
RIOT_API_KEY=RGAPI-...            # 개발 키는 24시간마다 만료 → https://developer.riotgames.com 에서 재발급
