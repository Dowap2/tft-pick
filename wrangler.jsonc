{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 정적 사이트(out/) + /api/* 만 Worker. 페이지·에셋은 Worker 호출 없이 Static Assets 가 직접 서빙.
  "name": "panlab",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true },
  // Worker 런타임 변수. wrangler deploy 가 대시보드 값을 덮어쓰므로 여기가 원본.
  // anon 키·URL 은 공개값(클라이언트 번들에도 들어감). 비밀(service_role 등)은 절대 여기 두지 말고 `wrangler secret put`.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://lrcqmzhnyaykrqzxhiyg.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxyY3FtemhueWF5a3JxenhoaXlnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk1OTg1MTEsImV4cCI6MjEwNTE3NDUxMX0.iWgVI1NacIz3A_p6dF-56Sn1D2BUVqcr5MyaqDA3ywc"
  }
}
